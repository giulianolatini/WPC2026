# Copia questo file in .env e inserisci i valori. Non fare commit di .env.
# AZ-01: permessi solo per il proprietario -> Linux/macOS: chmod 600 .env
# Il file è letto come coppie CHIAVE=valore, mai eseguito come script (AZ-08).
# Genera le chiavi con: echo "sk-$(openssl rand -hex 32)"

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-CHANGE-ME
# Solo profilo esteso. Genera una volta, NON rigenerare (le credenziali salvate diventano illeggibili).
LITELLM_SALT_KEY=sk-CHANGE-ME

# --- Immagini (AZ-02): sostituisci con i digest prodotti da scripts/pin-images.sh
# LITELLM_IMAGE=ghcr.io/berriai/litellm-non_root@sha256:<digest>
# POSTGRES_IMAGE=postgres:16@sha256:<digest>

# --- Superficie API (AZ-05): disattiva /docs, /redoc, /openapi.json
NO_DOCS=True
NO_REDOC=True
NO_OPENAPI=True

# --- Provider (API dirette, vedi docs/Decisions.md#d-003) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Token fine-grained con permesso "Make calls to Inference Providers"
HF_TOKEN=

# --- Solo profilo esteso (compose.extended.yaml) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=litellm
