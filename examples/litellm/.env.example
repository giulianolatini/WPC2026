# Copia questo file in .env e inserisci i valori. Non fare commit di .env.
# Genera le chiavi con: echo "sk-$(openssl rand -hex 32)"

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-CHANGE-ME
# Solo profilo esteso. Genera una volta, NON rigenerare (le credenziali salvate diventano illeggibili).
LITELLM_SALT_KEY=sk-CHANGE-ME

# --- Provider (API dirette, vedi docs/Decisions.md#d-003) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Token fine-grained con permesso "Make calls to Inference Providers"
HF_TOKEN=

# --- Solo profilo esteso (compose.extended.yaml) ---
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=litellm
