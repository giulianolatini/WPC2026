# systemd user unit per LiteLLM proxy (installato con uv tool).
# Installazione: cp litellm.service ~/.config/systemd/user/ && systemctl --user enable --now litellm.service
# Proposta del progetto: la documentazione LiteLLM non descrive systemd (docs/Sources.md#s-023).
# AZ-07: direttive di hardening (docs/Sources.md#s-144). Verifica con: systemd-analyze --user security litellm.service
# R-agy-03: avvio tramite start-litellm.sh (controllo dei permessi di .env, LITELLM_PORT), cache scrivibile.
[Unit]
Description=LiteLLM proxy (WPC2026)
# Nessun After=network-online.target: in una unit utente non ordina rispetto alle unit di sistema.

[Service]
Type=simple
WorkingDirectory=%h/wpc2026-litellm
# start-litellm.sh legge .env come CHIAVE=valore e rifiuta permessi diversi da 0600 (AZ-01, AZ-08).
ExecStart=%h/wpc2026-litellm/service/start-litellm.sh
# Cache dentro la cartella scrivibile: con ProtectHome=read-only ~/.cache non è scrivibile.
Environment=XDG_CACHE_HOME=%h/wpc2026-litellm/.cache
Environment=TIKTOKEN_CACHE_DIR=%h/wpc2026-litellm/.cache/tiktoken
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/wpc2026-litellm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
# ⚠️ In una unit utente alcune direttive di sandboxing richiedono i namespace utente: verifica con systemd-analyze e con l'avvio reale.

[Install]
WantedBy=default.target
